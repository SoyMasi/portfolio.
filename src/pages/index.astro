---
import Projects from "../components/home/projects.astro";
import Separator from "../components/home/separator.astro";
import About from "../components/home/about-me.astro";
import Skills from "../components/home/skills.astro";
import Layout from "../layouts/main.astro";
import Badge from "../components/Badge.astro";
---

<Layout
  title="Maximiliano Gomez Portfolio - Software Developer"
  description=""
>
  <div
    class="relative z-20 w-full max-w-4xl mx-auto mt-16 px-7 md:mt-24 lg:mt-32 xl:px-0"
    id="home"
  >
    <div class="flex flex-col items-center md:flex-row">
      <div class="relative w-full md:w-1/2">
        <h1
          class="mb-6 text-4xl font-bold leading-tight md:text-4xl lg:text-6xl dark:text-white"
        >
          Hey, I'm Maxi.
        </h1>
        <Badge />
        <p
          class="mb-4 text-base text-neutral-600 dark:text-neutral-400"
          style="padding-top: 20px;"
        >
          I'm a Software Developer and Electronics Technician, currently studying Information Systems Engineering
          in Rosario, Argentina.
        </p>
        <p class="mb-2 font-semibold text-neutral-800 dark:text-neutral-200">
          I can help you out with:
        </p>
        <ul
          class="py-2 space-y-[3px] text-sm list-disc list-inside text-neutral-500 dark:text-neutral-400"
        >
          <li>Python Applications Development</li>
          <li>Web Applications & Websites</li>
          <li>System Administration (Linux/Bash)</li>
          <li>Cybersecurity & CTF Challenges</li>
          <li>and more...</li>
        </ul>
        <a 
          href="https://drive.google.com/file/d/1e7nkpqpgFjGg0VPYrIQU5byePGLKcJs3/view?usp=drive_link"
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 mt-5 text-sm font-medium text-white bg-gray-900 hover:bg-white hover:text-gray-900 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-black dark:hover:text-white rounded-lg transition-colors duration-300 border border-gray-900 dark:border-gray-100 hover:border-gray-700 dark:hover:border-gray-300"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Download CV
        </a>
      </div>
      <div
        class="relative justify-end hidden w-full mt-10 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
      >
        <div class="relative z-50 w-full">
          <div class="relative z-30 px-10">
            <img
              src="/assets/images/me.gif"
              loading="eager"
              decoding="auto"
              class="relative z-30 w-full md:max-w-md mx-auto dark:-translate-y-0.5"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <Separator />
  <About id="about-me" />
  <Separator />
  <Skills />
  <Separator />
  <Projects id="projects" />
</Layout>
