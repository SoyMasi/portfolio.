<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width="45"
  height="45"
>
  <!-- Docker Whale -->
  <defs>
    <linearGradient id="docker-blue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0db7ed"/>
      <stop offset="100%" stop-color="#2496ed"/>
    </linearGradient>
  </defs>
  
  <!-- Water waves -->
  <path d="M0 180 Q64 160 128 180 T256 180 L256 256 L0 256 Z" fill="#0db7ed"/>
  
  <!-- Whale body -->
  <ellipse cx="128" cy="140" rx="80" ry="40" fill="url(#docker-blue)"/>
  
  <!-- Whale head -->
  <ellipse cx="60" cy="140" rx="35" ry="30" fill="url(#docker-blue)"/>
  
  <!-- Eye -->
  <circle cx="50" cy="130" r="4" fill="#ffffff"/>
  <circle cx="50" cy="130" r="2" fill="#000000"/>
  
  <!-- Spout -->
  <ellipse cx="40" cy="110" rx="3" ry="8" fill="#87ceeb"/>
  <ellipse cx="35" cy="105" rx="2" ry="6" fill="#87ceeb"/>
  <ellipse cx="45" cy="105" rx="2" ry="6" fill="#87ceeb"/>
  
  <!-- Containers on back -->
  <rect x="90" y="110" width="15" height="20" fill="#ff6b6b" rx="2"/>
  <rect x="110" y="110" width="15" height="20" fill="#4ecdc4" rx="2"/>
  <rect x="130" y="110" width="15" height="20" fill="#45b7d1" rx="2"/>
  <rect x="150" y="110" width="15" height="20" fill="#96ceb4" rx="2"/>
  <rect x="170" y="110" width="15" height="20" fill="#feca57" rx="2"/>
  
  <!-- Container details -->
  <rect x="92" y="112" width="11" height="2" fill="#ffffff" opacity="0.7"/>
  <rect x="112" y="112" width="11" height="2" fill="#ffffff" opacity="0.7"/>
  <rect x="132" y="112" width="11" height="2" fill="#ffffff" opacity="0.7"/>
  <rect x="152" y="112" width="11" height="2" fill="#ffffff" opacity="0.7"/>
  <rect x="172" y="112" width="11" height="2" fill="#ffffff" opacity="0.7"/>
  
  <!-- Tail -->
  <path d="M200 140 Q220 120 240 140 Q220 160 200 140" fill="url(#docker-blue)"/>
</svg>
